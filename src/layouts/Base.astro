
---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Ayush Hardeniya",
  description = "Ayush Hardeniya is a software engineering student in India working on Linux, backend systems, infrastructure, and open source",
  image = "/og.png",
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ayush Hardeniya" />
    <meta name="theme-color" content="#1c1c1c" />
    <link rel="canonical" href={Astro.url} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1730" />
    <meta property="og:image:height" content="909" />
    <meta
      property="og:image:alt"
      content="Ayush Hardeniya — systems, Linux, backend, infrastructure, and open source"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #1c1c1c;
        --fg: #e8e6df;
        --muted: #a09f99;
        --subtle: #777771;
        --border: #343434;
        --accent: #80bfff;
        --width: 680px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scrollbar-gutter: stable;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 16px;
        line-height: 1.75;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      a {
        color: var(--accent);
        text-decoration: underline;
        text-decoration-color: transparent;
        text-underline-offset: 3px;
      }

      a:hover {
        text-decoration-color: currentColor;
      }

      a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 4px;
      }

      .wrap {
        width: min(100% - 40px, var(--width));
        margin-inline: auto;
        padding-block: 36px 28px;
      }

      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 64px;
      }

      .brand {
        min-width: 0;
        line-height: 1.5;
      }

      .brand b {
        font-size: 17px;
        font-weight: 650;
      }

      .brand small {
        display: block;
        color: var(--muted);
        font-size: 13px;
      }

      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        font-size: 15px;
      }

      nav a,
      nav a:visited {
        color: var(--fg);
        text-decoration: none;
      }

      nav a:hover,
      nav a[aria-current="page"] {
        color: var(--accent);
      }

      nav a[aria-current="page"] {
        text-decoration: underline;
        text-underline-offset: 5px;
      }

      main {
        min-width: 0;
      }

      h1,
      h2,
      h3 {
        line-height: 1.25;
        text-wrap: balance;
      }

      h1 {
        margin: 0 0 24px;
        font-size: clamp(34px, 4.5vw, 46px);
        font-weight: 700;
        letter-spacing: -0.045em;
      }

      h2 {
        margin: 0 0 20px;
        font-size: 23px;
        font-weight: 650;
        letter-spacing: -0.025em;
      }

      h3 {
        font-size: 17px;
        font-weight: 600;
      }

      p {
        margin: 0 0 18px;
      }

      .hero-wrap {
        display: flex;
        align-items: flex-start;
        gap: 32px;
      }

      .hero-text {
        flex: 1;
        min-width: 0;
      }

      .hero-avatar {
        display: block;
        width: 120px;
        height: auto;
        flex: 0 0 auto;
        border-radius: 2px;
        filter: grayscale(100%);
      }

      .small {
        color: var(--muted);
        font-size: 14px;
      }

      .muted {
        color: var(--muted);
      }

      .stack {
        display: block;
        margin-top: 4px;
        color: var(--muted);
        font-size: 13px;
      }

      .section {
        margin-top: 56px;
      }

      .section.first {
        margin-top: 0;
      }

      ul {
        margin: 0 0 20px;
        padding-left: 22px;
      }

      li {
        margin-block: 8px;
        padding-left: 2px;
      }

      li::marker {
        color: var(--subtle);
      }

      code {
        font-size: 0.9em;
        overflow-wrap: anywhere;
      }

      pre {
        max-width: 100%;
        overflow-x: auto;
        padding: 16px;
        background: #161616;
        border: 1px solid var(--border);
        border-radius: 3px;
        font-size: 13px;
      }

      pre code {
        overflow-wrap: normal;
      }

      .div {
        height: 1px;
        margin-block: 32px;
        background: var(--border);
      }

      .links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 14px;
        margin-top: 16px;
      }

      .links span {
        color: var(--subtle);
      }

      footer {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px 20px;
        margin-top: 40px;
        padding-top: 16px;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 12px;
        line-height: 1.8;
      }

      footer a,
      footer a:visited {
        color: var(--muted);
      }

      .signature {
        margin-top: 40px;
        text-align: right;
        font-family: cursive;
        font-size: 20px;
        color: var(--muted);
        transform: rotate(-3deg);
      }

      @media (max-width: 560px) {
        .wrap {
          width: calc(100% - 36px);
          padding-top: 24px;
        }

        header {
          align-items: flex-start;
          flex-direction: column;
          gap: 16px;
          margin-bottom: 48px;
        }

        nav {
          gap: 20px;
        }

        .hero-wrap {
          flex-direction: column-reverse;
          gap: 24px;
        }

        .hero-avatar {
          width: 108px;
        }

        .section {
          margin-top: 44px;
        }

        footer {
          margin-top: 56px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
        }
      }

    /* booking tabs */
    .booking-tabs {
      display: flex;
      gap: 24px;
      margin: 28px 0 20px;
      border-bottom: 1px solid var(--border);
    }

    .booking-tab {
      appearance: none;
      border: 0;
      border-bottom: 2px solid transparent;
      margin: 0 0 -1px;
      padding: 0 0 10px;
      background: transparent;
      color: var(--muted);
      font: inherit;
      font-size: 14px;
      cursor: pointer;
    }

    .booking-tab:hover {
      color: var(--fg);
    }

    .booking-tab.active {
      color: var(--fg);
      border-bottom-color: var(--accent);
    }

    .booking-tab:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 4px;
    }

    .calendar-frame {
      position: relative;
      min-height: 620px;
    }

    .calendar-frame[hidden] {
      display: none;
    }

    .booking-fallback {
      margin-top: 12px;
      color: var(--muted);
      font-size: 13px;
    }

    @media (max-width: 560px) {
      .calendar-frame {
        min-height: 580px;
      }
    }
    </style>
  </head>

  <body>
    <div class="wrap">
      <header>
        <div class="brand">
          <b>ayushhardeniya.me</b>
          <small>systems / linux / infra</small>
        </div>

        <nav aria-label="Main navigation">
          <a href="/" aria-current={pathname === "/" ? "page" : undefined}>
            home
          </a>
          <a
            href="/work/"
            aria-current={pathname === "/work" ? "page" : undefined}
          >
            work
          </a>
          <a
            href="/blog/"
            aria-current={pathname.startsWith("/blog") ? "page" : undefined}
          >
            blog
          </a>
          <a
            href="/now/"
            aria-current={pathname === "/now" ? "page" : undefined}
          >
            now
          </a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer>
        <span>
          inspired by
          <a href="https://motherfuckingwebsite.com/">
            motherfuckingwebsite.com
          </a>
        </span>

        <span>
          <a href="https://github.com/ayushHardeniya/ayushhardeniya.me">source</a>
          ·
          <a href="/rss.xml">rss</a>
          · © 2026 Ayush Hardeniya
        </span>
      </footer>
    </div>
  </body>
</html>
