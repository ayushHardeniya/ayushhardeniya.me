
---
import Base from "../layouts/Base.astro";
---

<Base
  title="Book a call | Ayush Hardeniya"
  description="Book a call with Ayush Hardeniya."
>
  <h1>book a call</h1>

  <p>
    Want to talk about a role, collaborate on something, or discuss an idea?
    Pick a time that works for you.
  </p>

  <div class="booking">
    <div class="booking-tabs" role="tablist" aria-label="Call duration">
      <button
        class="booking-tab active"
        data-event="15min"
        id="tab-15min"
        role="tab"
        aria-selected="true"
        aria-controls="calendar-15min"
      >
        15 min
      </button>

      <button
        class="booking-tab"
        data-event="30min"
        id="tab-30min"
        role="tab"
        aria-selected="false"
        aria-controls="calendar-30min"
      >
        30 min
      </button>
    </div>

    <div
      class="calendar-frame active"
      data-calendar="15min"
      id="calendar-15min"
      role="tabpanel"
      aria-labelledby="tab-15min"
    >
      <div
        style="width:100%;height:100%;overflow:hidden"
        id="my-cal-inline-15min"
      ></div>

      <script>
        (function (C, A, L) {
          let p = function (a, ar) {
            a.q.push(ar);
          };
          let d = C.document;
          C.Cal =
            C.Cal ||
            function () {
              let cal = C.Cal;
              let ar = arguments;
              if (!cal.loaded) {
                cal.ns = {};
                cal.q = cal.q || [];
                d.head.appendChild(d.createElement("script")).src = A;
                cal.loaded = true;
              }
              if (ar[0] === L) {
                const api = function () {
                  p(api, arguments);
                };
                const namespace = ar[1];
                api.q = api.q || [];
                if (typeof namespace === "string") {
                  cal.ns[namespace] = cal.ns[namespace] || api;
                  p(cal.ns[namespace], ar);
                  p(cal, ["initNamespace", namespace]);
                } else p(cal, ar);
                return;
              }
              p(cal, ar);
            };
        })(window, "https://app.cal.com/embed/embed.js", "init");

        Cal("init", "15min", { origin: "https://app.cal.com" });
        Cal.config = Cal.config || {};
        Cal.config.forwardQueryParams = true;

        Cal.ns["15min"]("inline", {
          elementOrSelector: "#my-cal-inline-15min",
          config: {
            layout: "month_view",
            useSlotsViewOnSmallScreen: "true",
          },
          calLink: "ayushhardeniya/15min",
        });

        Cal.ns["15min"]("ui", {
          hideEventTypeDetails: false,
          layout: "month_view",
        });
      </script>

      <p class="booking-fallback">
        Calendar not loading?
        <a
          href="https://cal.com/ayushhardeniya/15min"
          target="_blank"
          rel="noopener noreferrer"
        >
          Open it on cal.com.
        </a>
      </p>
    </div>

    <div
      class="calendar-frame"
      data-calendar="30min"
      id="calendar-30min"
      role="tabpanel"
      aria-labelledby="tab-30min"
      hidden
    >
      <div
        style="width:100%;height:100%;overflow:hidden"
        id="my-cal-inline-30min"
      ></div>

      <script>
        (function (C, A, L) {
          let p = function (a, ar) {
            a.q.push(ar);
          };
          let d = C.document;
          C.Cal =
            C.Cal ||
            function () {
              let cal = C.Cal;
              let ar = arguments;
              if (!cal.loaded) {
                cal.ns = {};
                cal.q = cal.q || [];
                d.head.appendChild(d.createElement("script")).src = A;
                cal.loaded = true;
              }
              if (ar[0] === L) {
                const api = function () {
                  p(api, arguments);
                };
                const namespace = ar[1];
                api.q = api.q || [];
                if (typeof namespace === "string") {
                  cal.ns[namespace] = cal.ns[namespace] || api;
                  p(cal.ns[namespace], ar);
                  p(cal, ["initNamespace", namespace]);
                } else p(cal, ar);
                return;
              }
              p(cal, ar);
            };
        })(window, "https://app.cal.com/embed/embed.js", "init");

        Cal("init", "30min", { origin: "https://app.cal.com" });
        Cal.config = Cal.config || {};
        Cal.config.forwardQueryParams = true;

        Cal.ns["30min"]("inline", {
          elementOrSelector: "#my-cal-inline-30min",
          config: {
            layout: "month_view",
            useSlotsViewOnSmallScreen: "true",
            theme: "dark",
          },
          calLink: "ayushhardeniya/30min",
        });

        Cal.ns["30min"]("ui", {
          theme: "dark",
          hideEventTypeDetails: false,
          layout: "month_view",
        });
      </script>

      <p class="booking-fallback">
        Calendar not loading?
        <a
          href="https://cal.com/ayushhardeniya/30min"
          target="_blank"
          rel="noopener noreferrer"
        >
          Open it on cal.com.
        </a>
      </p>
    </div>
  </div>
</Base>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".booking-tab");
  const calendars = document.querySelectorAll<HTMLElement>(".calendar-frame");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const event = tab.dataset.event;

      tabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle("active", active);
        item.setAttribute("aria-selected", String(active));
      });

      calendars.forEach((calendar) => {
        calendar.hidden = calendar.dataset.calendar !== event;
      });
    });
  });

  setTimeout(() => {
    document
      .querySelectorAll<HTMLElement>(".calendar-frame")
      .forEach((frame) => {
        const calendar = frame.querySelector<HTMLDivElement>(
          'div[id^="my-cal-inline"]',
        );

        if (calendar && !calendar.querySelector("iframe")) {
          frame.classList.add("unavailable");
        }
      });
  }, 8000);
</script>
