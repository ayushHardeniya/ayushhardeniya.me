---
import Base from "../layouts/Base.astro";
---

<Base
  title="Book a call | Ayush Hardeniya"
  description="Book a call with Ayush Hardeniya."
>
  <h1>book a call!</h1>

  <p>
    Hiring, a collab, an idea, or something you want built.
    Pick a length, then a time that suits you.
  </p>

  <div class="booking">
    <div class="booking-tabs" role="tablist">
      <button
        class="booking-tab active"
        data-event="15min"
        role="tab"
        aria-selected="true"
      >
        Quick Call
      </button>

      <button
        class="booking-tab"
        data-event="30min"
        role="tab"
        aria-selected="false"
      >
        Need more time
      </button>
    </div>

    <div
      class="calendar-frame active"
      data-calendar="15min"
    >
    <div class="calendar-placeholder">
      <span>calendar unavailable</span>
      <small>check your connection or open it on cal.com</small>
    </div>
      <!-- Cal inline embed code begins (15 min) -->
    <div style="width:100%;height:100%;overflow:hidden" id="my-cal-inline-15min"></div>
    <script type="text/javascript">
    (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
    Cal("init", "15min", {origin:"https://app.cal.com"});
    Cal.config = Cal.config || {};
    Cal.config.forwardQueryParams = true;

    Cal.ns["15min"]("inline", {
        elementOrSelector:"#my-cal-inline-15min",
        config: {"layout":"month_view","useSlotsViewOnSmallScreen":"true"},
        calLink: "ayushhardeniya/15min",
    });

    Cal.ns["15min"]("ui", {"hideEventTypeDetails":false,"layout":"month_view"});
    </script>
    <p class="booking-fallback">
      Calendar not loading? <a href="https://cal.com/ayushhardeniya/15min" target="_blank" rel="noopener noreferrer">Open it on cal.com.</a>
    </p>
    <!-- Cal inline embed code ends -->
    </div>

    <div
      class="calendar-frame"
      data-calendar="30min"
      hidden
    >
      <!-- Cal inline embed code begins (30 min) -->
      <div class="calendar-placeholder">
        <span>calendar unavailable</span>
        <small>check your connection or open it on cal.com</small>
      </div>
        <div style="width:100%;height:100%;overflow:hidden" id="my-cal-inline-30min"></div>
        <script type="text/javascript">
        (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
        Cal("init", "30min", {origin:"https://app.cal.com"});
        Cal.config = Cal.config || {};
        Cal.config.forwardQueryParams = true;

        Cal.ns["30min"]("inline", {
            elementOrSelector:"#my-cal-inline-30min",
            config: {"layout":"month_view","useSlotsViewOnSmallScreen":"true","theme":"dark"},
            calLink: "ayushhardeniya/30min",
        });

        Cal.ns["30min"]("ui", {"theme":"dark","hideEventTypeDetails":false,"layout":"month_view"});
        </script>
        <p class="booking-fallback">
          Calendar not loading? <a href="https://cal.com/ayushhardeniya/30min" target="_blank" rel="noopener noreferrer">Open it on cal.com.</a>
        </p>
        <!-- Cal inline embed code ends -->
    </div>
  </div>
</Base>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".booking-tab");
  const calendars = document.querySelectorAll<HTMLElement>(".calendar-frame");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const event = tab.dataset.event;

      tabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle("active", active);
        item.setAttribute("aria-selected", String(active));
      });

      calendars.forEach((calendar) => {
        const active = calendar.dataset.calendar === event;
        calendar.hidden = !active;
      });
    });
  });
  setTimeout(() => {
    document.querySelectorAll<HTMLElement>(".calendar-frame").forEach((frame) => {
      const calendar = frame.querySelector('div[id^="my-cal-inline"]');

      if (calendar && !calendar.querySelector("iframe")) {
        frame.classList.add("unavailable");
      }
    });
  }, 8000);
</script>
