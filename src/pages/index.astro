
---
import Base from "../layouts/Base.astro";
---

<Base
  title="Ayush Hardeniya"
  description="Ayush Hardeniya is a software engineering student in India working on Linux, backend systems, infrastructure, and open source"
>
  <section class="intro">

    <h1>hey, I'm Ayush</h1>

    <p>
      I'm a software engineering student from India. Interested in how systems
      work, from Linux and backend software to infrastructure and open source.
    </p>

    <p>
      Currently contributing to
      <a href="https://salsa.debian.org/freexian-team/debusine">Debusine</a>
      in Debian, while going deeper into Linux and systems engineering.
    </p>
  
    <div class="links" aria-label="Find me online">
      <a href="https://github.com/ayushHardeniya" target="_blank" rel="noopener noreferrer">github</a>
      <a href="https://salsa.debian.org/ayushhardeniya" target="_blank" rel="noopener noreferrer">salsa</a>
      <a href="https://www.linkedin.com/in/ayushHardeniya" target="_blank" rel="noopener noreferrer">linkedin</a>
      <a href="https://x.com/ayushHardeniya" target="_blank" rel="noopener noreferrer">x</a>
      <a href="mailto:ayush@ayushhardeniya.me">email</a>
      <a href="/resume">resume</a>
    </div>

    <p class="small contact">
      Want to talk? <a href="/book/">book a call ↗</a>
    </p>
  </section>

  <section class="section writing">
    <h2>Recent writing</h2>

    <article class="post">
      <time datetime="2026-09-25">25 Sep 2026</time>
      <a href="/blog/who-am-i/">who am i?</a>
    </article>

    <p class="small more">
      <a href="/blog/">all writing →</a>
    </p>
  </section>
</Base>

<style>
  .eyebrow {
    margin-bottom: 18px;
    color: var(--accent);
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0.1em;
  }

  .intro h1 {
    margin-bottom: 24px;
  }

  .intro > p:not(.eyebrow) {
    max-width: 620px;
  }

  .links {
    gap: 10px 20px;
    margin-top: 28px;
  }

  .contact {
    margin-top: 20px;
  }

  .writing {
    margin-top: 76px;
  }

  .writing h2 {
    margin-bottom: 22px;
  }

  .post {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 24px;
    padding-block: 12px;
    border-bottom: 1px solid var(--border);
  }

  .post time {
    flex: 0 0 100px;
    color: var(--muted);
    font-size: 13px;
  }

  .post a {
    color: var(--fg);
  }

  .more {
    margin-top: 20px;
  }

  @media (max-width: 560px) {
    .writing {
      margin-top: 56px;
    }

    .post {
      gap: 4px 16px;
    }
  }
</style>
